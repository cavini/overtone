{
  "name": "@overtone/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./repositories": "./src/repositories/index.ts",
    "./lemmas": "./src/lemmas/index.ts"
  },
  "scripts": {
    "test": "vitest",
    "test:unit": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.mts",
    "db:check": "drizzle-kit check",
    "db:reset": "tsx src/reset.mts",
    "db:inspect": "tsx src/inspect.mts",
    "db:load-lemmas": "tsx src/load-lemmas.mts",
    "db:smoke": "tsx src/smoke.mts",
    "test:integration": "vitest run -c vitest.integration.config.ts"
  },
  "dependencies": {
    "@overtone/core": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "drizzle-kit": "^0.31.11",
    "vitest": "^5.0.3"
  }
}
