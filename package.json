{
  "name": "overtone",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "sh -c 'set -a; [ -f .env.local ] && . ./.env.local; set +a; pnpm --filter @overtone/web dev'",
    "test": "pnpm -r --parallel test",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm -r --if-present test:integration",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm typecheck && pnpm lint:deps && pnpm test:unit",
    "lint:deps": "depcruise packages --config .dependency-cruiser.cjs",
    "fetch:lemmas": "tsx scripts/fetch-lemmas.mts",
    "prepare": "husky",
    "fetch:episode": "tsx scripts/fetch-episode.mts"
  },
  "devDependencies": {
    "@rolldown/binding-darwin-arm64": "^1.2.13",
    "@vitest/coverage-v8": "^5.0.3",
    "dependency-cruiser": "^18.5.0",
    "husky": "^9.1.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
