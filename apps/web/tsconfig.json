{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The only package that compiles with DOM types. `packages/core` has
    // none, which is the architecture boundary stated as build configuration.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "preserve",
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "allowJs": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "next-env.d.ts", ".next/types/**/*.ts", "*.ts", "*.mjs"]
}
