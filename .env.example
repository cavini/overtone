# Copy to .env.local and fill in. .env.local is gitignored — the real values
# live only on your machine and in Vercel's environment settings.

# ─── Database, for migrations ────────────────────────────────────────────────
# Supabase → Connect → ORMs → Drizzle, then change the port to 5432.
#
# The string Supabase hands you uses 6543, which is the *transaction* pooler:
# no prepared statements, no session state, and migrations need both. Port
# 5432 on the same host is the *session* pooler, which runs DDL fine and works
# over IPv4 — unlike the `db.*.supabase.co` direct connection, which is
# IPv6-only without a paid add-on.
# Port 6543 is the *transaction* pooler: a connection is returned to the
# pool after every statement. That is what a serverless app needs. Port 5432
# is the *session* pooler, which holds one connection per client for its
# whole life against a cap of 15 — a handful of warm Vercel instances
# exhausts it and the app starts failing with EMAXCONNSESSION.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-1-sa-east-1.pooler.supabase.com:6543/postgres

# Migrations need the session pooler: DDL and prepared statements want a
# connection that stays put. Used only by the scripts, never by the app.
MIGRATION_DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

# ─── Supabase, for the app ───────────────────────────────────────────────────
# Supabase → Connect → App Frameworks → Next.js
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
# Safe in a browser by design; row-level security is what protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-side only. Bypasses row-level security entirely, so it must never be
# prefixed NEXT_PUBLIC_ and must never reach the browser. Needed for the
# public share-link route, which checks the token itself and returns exactly
# one episode.
SUPABASE_SECRET_KEY=sb_secret_...

# ─── Transcription ───────────────────────────────────────────────────────────
# console.groq.com → API Keys. Free, no card.
GROQ_API_KEY=gsk_...

# ─── Access ──────────────────────────────────────────────────────────────────
# One shared password for the whole group. Not about privacy — it is what
# stops a stranger who finds the URL spending the transcription allowance,
# which is three episodes a day for everyone together.
#
# Leave it unset locally and there is no gate at all. Production sets it.
OVERTONE_PASSWORD=

# The show's own RSS feed, if it has one. Used to read the published title
# and show notes for an episode, matched by number.
#
# A private feed carries its token in the path, so treat this like a
# password: it never goes in the repository and never reaches the browser.
# Leave it unset and episodes keep the title read from their filename.
OVERTONE_FEED_URL=
