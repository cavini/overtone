# Copy this file to .env.local and fill it in. .env.local is gitignored and
# never committed — the real values live only on your machine and in Vercel.

# Supabase → Project Settings → Database → Connection string → URI
# Used by migrations. Swap the [YOUR-PASSWORD] placeholder for the real one.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxx.supabase.co:5432/postgres

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Bypasses row-level security, so it must never reach the
# browser or be prefixed NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# console.groq.com → API Keys. Free, no card.
GROQ_API_KEY=
