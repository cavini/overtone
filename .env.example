# Copy to .env.local and fill in. .env.local is gitignored — the real values
# live only on your machine and in Vercel's environment settings.

# ─── Database, for the app ───────────────────────────────────────────────────
# Supabase → Connect → ORMs → Drizzle. Keep the port it hands you, 6543.
#
# Port 6543 is the *transaction* pooler: a connection is returned to the
# pool after every statement. That is what a serverless app needs. Port 5432
# is the *session* pooler, which holds one connection per client for its
# whole life against a cap of 15 — a handful of warm Vercel instances
# exhausts it and the app starts failing with EMAXCONNSESSION.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-1-sa-east-1.pooler.supabase.com:6543/postgres

# ─── Database, for migrations ────────────────────────────────────────────────
# The same string with the port changed to 5432. Migrations need the session
# pooler: DDL and prepared statements want a connection that stays put. Run
# from a laptop, so Vercel never needs this one. The `db.*.supabase.co` direct
# connection would also work but is IPv6-only without a paid add-on.
MIGRATION_DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

# ─── Supabase, for the app ───────────────────────────────────────────────────
# Supabase → Connect → App Frameworks → Next.js
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
# Safe in a browser by design; row-level security is what protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-side only. Bypasses row-level security entirely, so it must never be
# prefixed NEXT_PUBLIC_ and must never reach the browser. Needed for the
# public share-link route, which checks the token itself and returns exactly
# one episode.
SUPABASE_SECRET_KEY=sb_secret_...

# ─── The scheduler ───────────────────────────────────────────────────────────
# What pg_cron presents when it calls /api/episodes/advance-pending every
# minute to push unfinished episodes along (ADR 0029).
#
# Set this. Leaving it unset does not disable the endpoint — it makes it
# *open*, because a deployment with no secret configured has no way to tell
# the scheduler from anybody else, and refusing every caller would stop the
# transcription loop dead. An open one lets a stranger who finds the URL
# drive the queue, which spends the Groq allowance the whole group shares.
#
# Any long random string. The same value goes in Vercel and in the pg_cron
# job's Authorization header.
CRON_SECRET=

# ─── Transcription ───────────────────────────────────────────────────────────
# console.groq.com → API Keys. Free, no card.
GROQ_API_KEY=gsk_...

# ─── Access ──────────────────────────────────────────────────────────────────
# stops a stranger who finds the URL spending the transcription allowance,
# which is three episodes a day for everyone together.
#
# Leave it unset locally and there is no gate at all. Production sets it.
OVERTONE_ACCOUNT_EMAIL=                 # an account the e2e suite and the backfill sign in as
OVERTONE_ACCOUNT_PASSWORD=

# The show's own RSS feed, if it has one. Used to read the published title
# and show notes for an episode, matched by number.
#
# A private feed carries its token in the path, so treat this like a
# password: it never goes in the repository and never reaches the browser.
# Leave it unset and episodes keep the title read from their filename.
OVERTONE_FEED_URL=

# Which show in OVERTONE_FEED_URL to read, when the feed carries more than
# one. Only used by the live feed test; leave it unset to skip that suite.
# Who may create an account, comma separated. Registration FAILS CLOSED
# without this: an open form hands out accounts, and the transcription
# allowance behind them, to whoever finds the URL. Signing in to an account
# that already exists still works with this unset.
OVERTONE_INVITED=

OVERTONE_FEED_SHOW=
